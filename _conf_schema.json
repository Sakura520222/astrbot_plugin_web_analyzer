{
  "分析设置": {
    "description": "链接与分析",
    "type": "object",
    "hint": "选择触发方式、摘要长度和提取内容。",
    "items": {
      "analysis_mode": {
        "description": "分析模式", "type": "string", "default": "auto", "_special": "select",
        "hint": "自动和混合模式会处理消息中的链接；手动模式仅响应命令。",
        "options": ["auto", "manual", "hybrid", "LLMTOOL"],
        "labels": ["自动分析", "仅手动命令", "混合模式", "模型工具"],
        "subtitles": ["检测到链接后分析", "使用 /网页分析 触发", "自动分析，可由管理员切换", "由模型调用网页分析工具"]
      },
      "llmtool_url_strategy": {
        "description": "工具模式的多链接处理", "type": "string", "default": "auto_analyze", "_special": "select",
        "hint": "仅在模型工具模式下使用。",
        "options": ["auto_analyze", "llm_hint", "batch_tool"],
        "labels": ["先分析全部链接", "向模型提示链接列表", "由模型调用批量工具"]
      },
      "max_summary_length": {
        "description": "摘要长度上限（字符）", "type": "int", "default": 2000,
        "hint": "限制分析摘要的字符数。", "minimum": 500, "maximum": 10000
      },
      "enable_statistics": {
        "description": "显示内容统计", "type": "bool", "default": true,
        "hint": "在结果中显示字符数、段落数等信息。"
      },
      "enable_emoji": {
        "description": "结果中的表情符号", "type": "bool", "default": true,
        "hint": "仅影响发送到聊天的分析结果，控制台不使用表情符号。"
      },
      "内容提取": {
        "description": "内容提取", "type": "object",
        "hint": "按需要提取图片、链接、表格或代码等内容。",
        "items": {
          "enable_specific_extraction": {
            "description": "启用指定内容提取", "type": "bool", "default": false,
            "hint": "开启后按下方列表提取内容。"
          },
          "extract_types": {
            "description": "提取类型", "type": "text", "default": "title\ncontent",
            "hint": "每行一个：title、content、images、links、tables、lists、code、meta、videos、audios、quotes、headings、paragraphs、buttons、forms。"
          }
        }
      }
    }
  },
  "智能分析": {
    "description": "模型与翻译", "type": "object",
    "hint": "使用 AstrBot 中已配置的模型分析或翻译网页。",
    "items": {
      "llm_enabled": {
        "description": "启用模型分析", "type": "bool", "default": true,
        "hint": "关闭后使用基础内容提取结果。"
      },
      "llm_provider": {
        "description": "分析模型", "type": "string", "_special": "select_provider",
        "hint": "留空使用当前会话的模型。"
      },
      "custom_prompt": {
        "description": "分析提示词", "type": "text", "default": "",
        "hint": "留空使用内置提示词。可用变量：{title}、{url}、{content}、{max_length}。"
      },
      "enable_llm_decision": {
        "description": "由模型选择输出内容", "type": "bool", "default": false,
        "hint": "允许模型选择发送分析结果或截图。"
      },
      "翻译功能": {
        "description": "网页翻译", "type": "object", "hint": "设置目标语言和翻译提示词。",
        "items": {
          "enable_translation": {
            "description": "启用翻译", "type": "bool", "default": false,
            "hint": "翻译抓取到的网页内容。"
          },
          "target_language": {
            "description": "目标语言", "type": "string", "default": "zh",
            "hint": "语言代码，例如 zh、en、ja。"
          },
          "translation_provider": {
            "description": "翻译提供商", "type": "string", "default": "llm",
            "hint": "llm 使用分析模型；也可填写 AstrBot 中已配置的模型 ID。"
          },
          "custom_translation_prompt": {
            "description": "翻译提示词", "type": "text", "default": "",
            "hint": "留空使用内置提示词。可用变量：{content}、{target_language}。"
          }
        }
      }
    }
  },
  "展示设置": {
    "description": "输出与截图", "type": "object",
    "hint": "设置回复内容、排版和网页截图。",
    "items": {
      "send_content_type": {
        "description": "回复内容", "type": "string", "default": "both", "_special": "select",
        "hint": "截图还需要启用下方的网页截图功能。",
        "options": ["both", "analysis_only", "screenshot_only"],
        "labels": ["分析结果与截图", "仅分析结果", "仅截图"]
      },
      "result_template": {
        "description": "结果模板", "type": "string", "default": "default", "_special": "select",
        "hint": "选择自定义时使用下方填写的模板。",
        "options": ["default", "detailed", "compact", "markdown", "simple", "custom"],
        "labels": ["默认", "详细", "紧凑", "Markdown", "简洁", "自定义"]
      },
      "网页截图": {
        "description": "网页截图", "type": "object",
        "hint": "使用系统浏览器。单张截图最多 1000 万像素。",
        "items": {
          "enable_screenshot": {
            "description": "启用截图", "type": "bool", "default": true,
            "hint": "需要在 AstrBot 运行环境中安装 Chrome、Edge 或 Chromium。"
          },
          "screenshot_format": {
            "description": "图片格式", "type": "string", "default": "jpeg", "_special": "select",
            "hint": "JPEG 文件较小，PNG 使用无损压缩。",
            "options": ["jpeg", "png"], "labels": ["JPEG", "PNG"]
          },
          "screenshot_quality": {
            "description": "JPEG 质量", "type": "int", "default": 80,
            "hint": "仅对 JPEG 生效；数值越高，文件通常越大。", "minimum": 10, "maximum": 100
          },
          "截图尺寸": {
            "description": "视口尺寸", "type": "object", "hint": "设置浏览器视口的宽度和高度。",
            "items": {
              "screenshot_width": {
                "description": "宽度（像素）", "type": "int", "default": 1280,
                "hint": "浏览器视口宽度。", "minimum": 320, "maximum": 4096
              },
              "screenshot_height": {
                "description": "高度（像素）", "type": "int", "default": 720,
                "hint": "浏览器视口高度。", "minimum": 240, "maximum": 4096
              }
            }
          },
          "screenshot_full_page": {
            "description": "截取整页", "type": "bool", "default": false,
            "hint": "关闭时仅截取视口范围。"
          },
          "screenshot_wait_strategy": {
            "description": "等待策略", "type": "string", "default": "fixed", "_special": "select",
            "hint": "页面内容未加载完整时，可增加等待时间。",
            "options": ["fixed", "networkidle", "smart"],
            "labels": ["固定等待", "等待网络空闲", "网络空闲后短暂等待"]
          },
          "screenshot_wait_ms": {
            "description": "等待时间（毫秒）", "type": "int", "default": 2000,
            "hint": "截图前额外等待的时间。", "minimum": 0, "maximum": 10000
          },
          "裁剪设置": {
            "description": "截图裁剪", "type": "object", "hint": "只保留指定的矩形区域。",
            "items": {
              "enable_crop": {
                "description": "启用裁剪", "type": "bool", "default": false,
                "hint": "开启后使用下方的裁剪坐标。"
              },
              "crop_area": {
                "description": "裁剪坐标", "type": "string", "default": "[0, 0, 1280, 720]",
                "hint": "格式：[左, 上, 右, 下]，例如 [0, 0, 1280, 720]。"
              }
            }
          }
        }
      },
      "结果折叠": {
        "description": "长结果折叠", "type": "object", "hint": "按字符数控制长结果的折叠。",
        "items": {
          "enable_collapsible": {
            "description": "启用折叠", "type": "bool", "default": false,
            "hint": "超过阈值时折叠结果。"
          },
          "collapse_threshold": {
            "description": "折叠阈值（字符）", "type": "int", "default": 1500,
            "hint": "超过此长度的结果会折叠。", "minimum": 500, "maximum": 5000
          }
        }
      },
      "自定义模板": {
        "description": "自定义模板", "type": "object", "hint": "设置模板文本及输出格式。",
        "items": {
          "enable_custom_template": {
            "description": "使用自定义模板", "type": "bool", "default": false,
            "hint": "开启后覆盖预设模板。"
          },
          "template_content": {
            "description": "模板内容", "type": "text",
            "hint": "可用变量：{title}、{url}、{content}、{summary}、{analysis_result}、{screenshot}、{content_type}、{stats}、{date}、{time}。",
            "default": "# 网页分析结果\n\n## 基本信息\n- 标题: {title}\n- 链接: {url}\n- 内容类型: {content_type}\n- 分析时间: {date} {time}\n\n## 内容摘要\n{summary}\n\n## 详细分析\n{analysis_result}\n\n## 内容统计\n{stats}"
          },
          "template_format": {
            "description": "输出格式", "type": "string", "default": "markdown", "_special": "select",
            "hint": "选择模板的文本格式。",
            "options": ["markdown", "plain", "html"], "labels": ["Markdown", "纯文本", "HTML"]
          }
        }
      },
      "URL识别": {
        "description": "链接识别", "type": "object", "hint": "处理消息中没有协议头的链接。",
        "items": {
          "enable_no_protocol_url": {
            "description": "识别无协议头的链接", "type": "bool", "default": false,
            "hint": "例如 www.example.com。"
          },
          "default_protocol": {
            "description": "补全协议", "type": "string", "default": "https", "_special": "select",
            "hint": "仅用于没有 http:// 或 https:// 的链接。",
            "options": ["http", "https"], "labels": ["HTTP", "HTTPS"]
          }
        }
      }
    }
  },
  "消息管理": {
    "description": "消息与会话", "type": "object",
    "hint": "设置群聊范围、发送方式和提示消息撤回。",
    "items": {
      "群聊设置": {
        "description": "群聊范围", "type": "object", "hint": "排除不需要分析的群聊。",
        "items": {
          "group_blacklist": {
            "description": "群聊黑名单", "type": "text", "default": "",
            "hint": "每行一个群号。列表中的群聊不触发自动分析。"
          }
        }
      },
      "事件传播": {
        "description": "后续回复", "type": "object", "hint": "设置分析后是否继续交给会话模型处理。",
        "items": {
          "allow_llm_propagation": {
            "description": "继续传递给模型", "type": "bool", "default": true,
            "hint": "开启后，可能同时收到网页分析结果和会话模型的回复。"
          }
        }
      },
      "合并转发": {
        "description": "合并转发", "type": "object", "hint": "在支持合并转发的平台上使用。",
        "items": {
          "group": {
            "description": "群聊合并转发", "type": "bool", "default": false,
            "hint": "群聊中将结果放入合并转发消息。"
          },
          "private": {
            "description": "私聊合并转发", "type": "bool", "default": false,
            "hint": "私聊中将结果放入合并转发消息。"
          },
          "include_screenshot": {
            "description": "将截图放入转发消息", "type": "bool", "default": false,
            "hint": "关闭时单独发送截图。"
          }
        }
      },
      "消息撤回": {
        "description": "提示消息撤回", "type": "object", "hint": "仅撤回“正在分析”的提示消息，依赖平台支持。",
        "items": {
          "enable_recall": {
            "description": "自动撤回提示", "type": "bool", "default": true,
            "hint": "开启后按下方策略撤回。"
          },
          "recall_type": {
            "description": "撤回时机", "type": "string", "default": "smart", "_special": "select",
            "hint": "按时撤回，或在分析完成后撤回。",
            "options": ["time_based", "smart"], "labels": ["达到延迟时间", "分析完成后"]
          },
          "recall_time_s": {
            "description": "撤回延迟（秒）", "type": "int", "default": 10,
            "hint": "定时撤回的延迟；完成后撤回模式的最长等待时间。", "minimum": 0, "maximum": 120
          },
          "smart_recall_enabled": {
            "description": "完成后立即撤回", "type": "bool", "default": true,
            "hint": "分析完成后立即撤回提示消息。"
          }
        }
      }
    }
  },
  "基础设置": {
    "description": "网络与资源", "type": "object",
    "hint": "设置抓取方式、访问范围、缓存和资源限制。",
    "items": {
      "网络设置": {
        "description": "网页抓取", "type": "object", "hint": "普通网页使用 HTTP 请求；需要 JavaScript 的页面可使用浏览器。",
        "items": {
          "fetch_mode": {
            "description": "抓取方式", "type": "string", "default": "httpx", "_special": "select",
            "hint": "浏览器模式使用系统浏览器渲染动态内容。旧值 playwright 自动映射为 browser。",
            "options": ["httpx", "browser"], "labels": ["HTTP 请求", "系统浏览器"]
          },
          "max_content_length": {
            "description": "内容长度上限（字符）", "type": "int", "default": 10000,
            "hint": "限制交给分析器的网页文本长度。", "minimum": 1000, "maximum": 1000000
          },
          "request_timeout_s": {
            "description": "请求超时（秒）", "type": "int", "default": 30,
            "hint": "超过此时间的请求会中止。", "minimum": 5, "maximum": 300
          },
          "max_concurrency": {
            "description": "并发上限", "type": "int", "default": 5,
            "hint": "同时处理的链接数量上限。", "minimum": 1, "maximum": 20
          },
          "retry_count": {
            "description": "重试次数", "type": "int", "default": 3,
            "hint": "请求失败后允许的重试次数。", "minimum": 0, "maximum": 10
          },
          "retry_delay_s": {
            "description": "重试间隔（秒）", "type": "int", "default": 2,
            "hint": "再次请求前等待的时间。", "minimum": 0, "maximum": 10
          },
          "user_agent": {
            "description": "User-Agent", "type": "string",
            "hint": "网页请求使用的 User-Agent 请求头。",
            "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
          },
          "proxy": {
            "description": "HTTP 代理", "type": "string", "default": "", "secret": true,
            "hint": "留空不使用代理。格式：http://用户名:密码@主机:端口；配置文件仍以明文保存。"
          },
          "hide_ip": {
            "description": "截图使用代理并限制 WebRTC", "type": "bool", "default": false,
            "hint": "需要配置代理。不能保证匿名访问。"
          }
        }
      },
      "浏览器设置": {
        "description": "系统浏览器", "type": "object",
        "hint": "直接使用 Chrome、Edge 或 Chromium，不下载额外浏览器。",
        "items": {
          "sandbox_mode": {
            "description": "沙箱模式", "type": "string", "default": "auto", "_special": "select",
            "hint": "自动模式按运行环境选择。禁用沙箱会降低浏览器隔离能力。",
            "options": ["auto", "always_disabled", "always_enabled"],
            "labels": ["自动检测", "始终禁用", "始终启用"]
          }
        }
      },
      "域名管理": {
        "description": "域名范围", "type": "object", "hint": "设置允许或禁止分析的域名。",
        "items": {
          "enable_unified_domain": {
            "description": "合并 www 域名", "type": "bool", "default": false,
            "hint": "将 example.com 与 www.example.com 等变体统一处理。"
          },
          "allowed_domains": {
            "description": "允许的域名", "type": "text", "default": "",
            "hint": "每行一个域名。留空允许所有未被禁止的域名。"
          },
          "blocked_domains": {
            "description": "禁止的域名", "type": "text", "default": "",
            "hint": "每行一个域名。"
          }
        }
      },
      "缓存设置": {
        "description": "结果缓存", "type": "object", "hint": "复用已分析的结果，减少重复请求。",
        "items": {
          "enable_cache": {
            "description": "启用缓存", "type": "bool", "default": true,
            "hint": "关闭后不复用分析结果。"
          },
          "cache_expire_time_min": {
            "description": "有效期（分钟）", "type": "int", "default": 1440,
            "hint": "1440 分钟为一天。", "minimum": 5, "maximum": 10080
          },
          "max_cache_size": {
            "description": "缓存条数上限", "type": "int", "default": 100,
            "hint": "限制保留的分析结果数量。", "minimum": 10, "maximum": 1000
          },
          "cache_preload_enabled": {
            "description": "预加载缓存", "type": "bool", "default": false,
            "hint": "将已有文件缓存提前载入内存。"
          },
          "cache_preload_count": {
            "description": "预加载条数", "type": "int", "default": 20,
            "hint": "启用预加载时使用。", "minimum": 0, "maximum": 100
          }
        }
      },
      "资源管理": {
        "description": "内存管理", "type": "object", "hint": "监控内存占用，并在超过阈值时释放资源。",
        "items": {
          "enable_memory_monitor": {
            "description": "启用内存监控", "type": "bool", "default": false,
            "hint": "定期检查内存使用情况。"
          },
          "memory_threshold_percent": {
            "description": "内存阈值（%）", "type": "float", "default": 80.0,
            "hint": "超过此占用比例时尝试释放资源。", "minimum": 0.0, "maximum": 100.0
          }
        }
      }
    }
  }
}
