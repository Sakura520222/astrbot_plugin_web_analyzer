{
  "trigger": {
    "description": "触发与发送",
    "type": "object",
    "hint": "设置自动截图的触发范围和发送方式。",
    "items": {
      "auto_capture": {
        "description": "自动识别链接", "type": "bool", "default": true,
        "hint": "聊天中检测到网页链接时自动截图。关闭后仅响应 /网页截图 命令。"
      },
      "handoff_to_model": {
        "description": "自动截图后继续交给会话模型", "type": "bool", "default": true,
        "hint": "开启后自动截图的结果直接发送，消息继续交给会话模型处理；关闭则截图后结束本轮处理。"
      },
      "enable_no_protocol_url": {
        "description": "识别无协议头的链接", "type": "bool", "default": false,
        "hint": "例如 www.example.com。"
      },
      "default_protocol": {
        "description": "补全协议", "type": "string", "default": "https", "_special": "select",
        "hint": "仅用于没有 http:// 或 https:// 的链接。",
        "options": ["http", "https"], "labels": ["HTTP", "HTTPS"]
      },
      "group_blacklist": {
        "description": "群聊黑名单", "type": "text", "default": "",
        "hint": "每行一个群号。列表中的群聊不触发自动截图。"
      },
      "enable_processing_message": {
        "description": "发送提示消息", "type": "bool", "default": true,
        "hint": "截图前发送“正在截图...”提示。关闭则直接发送结果。"
      },
      "enable_recall": {
        "description": "自动撤回提示", "type": "bool", "default": true,
        "hint": "开启后按下方策略撤回提示消息，依赖平台支持。"
      },
      "recall_type": {
        "description": "撤回时机", "type": "string", "default": "smart", "_special": "select",
        "hint": "按时撤回，或在截图完成后撤回。",
        "options": ["time_based", "smart"], "labels": ["达到延迟时间", "截图完成后"]
      },
      "recall_time_s": {
        "description": "撤回延迟（秒）", "type": "int", "default": 10,
        "hint": "定时撤回的延迟；完成后撤回模式的最长等待时间。", "minimum": 0, "maximum": 120
      },
      "smart_recall_enabled": {
        "description": "完成后立即撤回", "type": "bool", "default": true,
        "hint": "截图完成后立即撤回提示消息。"
      }
    }
  },
  "screenshot": {
    "description": "截图",
    "type": "object",
    "hint": "使用系统 Chrome / Edge / Chromium 截图。单张最多 1000 万像素。",
    "items": {
      "screenshot_width": {
        "description": "视口宽度（像素）", "type": "int", "default": 1280,
        "hint": "浏览器视口宽度。", "minimum": 320, "maximum": 4096
      },
      "screenshot_height": {
        "description": "视口高度（像素）", "type": "int", "default": 720,
        "hint": "浏览器视口高度。", "minimum": 240, "maximum": 4096
      },
      "screenshot_full_page": {
        "description": "截取整页", "type": "bool", "default": false,
        "hint": "开启时截取整个页面，关闭时仅截取视口范围。"
      },
      "screenshot_format": {
        "description": "图片格式", "type": "string", "default": "jpeg", "_special": "select",
        "hint": "JPEG 文件较小，PNG 使用无损压缩。",
        "options": ["jpeg", "png"], "labels": ["JPEG", "PNG"]
      },
      "screenshot_quality": {
        "description": "JPEG 质量", "type": "int", "default": 80,
        "hint": "仅对 JPEG 生效；数值越高，文件通常越大。", "minimum": 10, "maximum": 100
      },
      "screenshot_wait_strategy": {
        "description": "加载等待方式", "type": "string", "default": "fixed", "_special": "select",
        "hint": "页面内容未加载完整时，可改为等待网络空闲。",
        "options": ["fixed", "networkidle", "smart"],
        "labels": ["固定等待", "等待网络空闲", "网络空闲后短暂等待"]
      },
      "screenshot_wait_ms": {
        "description": "等待时间（毫秒）", "type": "int", "default": 2000,
        "hint": "截图前额外等待的时间。", "minimum": 0, "maximum": 10000
      },
      "screenshot_retry_count": {
        "description": "失败重试次数", "type": "int", "default": 1,
        "hint": "浏览器实例故障时更换实例重试的次数；页面加载失败或内容超限不重试。", "minimum": 0, "maximum": 3
      },
      "enable_crop": {
        "description": "启用裁剪", "type": "bool", "default": false,
        "hint": "开启后只保留下方指定的矩形区域。"
      },
      "crop_area": {
        "description": "裁剪坐标", "type": "string", "default": "[0, 0, 1280, 720]",
        "hint": "格式：[左, 上, 右, 下]，例如 [0, 0, 1280, 720]。"
      }
    }
  },
  "access": {
    "description": "访问规则",
    "type": "object",
    "hint": "限制自动截图和助手工具可以访问的域名。",
    "items": {
      "allowed_domains": {
        "description": "允许的域名", "type": "text", "default": "",
        "hint": "每行一个域名。留空允许所有未被禁止的域名。"
      },
      "blocked_domains": {
        "description": "禁止的域名", "type": "text", "default": "",
        "hint": "每行一个域名。"
      },
      "enable_unified_domain": {
        "description": "合并 www 域名", "type": "bool", "default": false,
        "hint": "将 example.com 与 www.example.com 等变体统一处理。"
      },
      "allow_local_addresses": {
        "description": "允许访问本地与内网地址", "type": "bool", "default": false,
        "hint": "开启后可截图或读取 127.0.0.1、192.168.x.x、localhost 等本地/内网地址；仅建议在可信网络环境开启。"
      }
    }
  },
  "cache": {
    "description": "缓存",
    "type": "object",
    "hint": "按链接与截图参数复用已生成的截图。",
    "items": {
      "enable_cache": {
        "description": "启用缓存", "type": "bool", "default": true,
        "hint": "相同的链接和截图参数直接复用已有截图。"
      },
      "cache_expire_time_min": {
        "description": "有效期（分钟）", "type": "int", "default": 1440,
        "hint": "1440 分钟为一天。", "minimum": 5, "maximum": 10080
      },
      "max_cache_size": {
        "description": "缓存条数上限", "type": "int", "default": 100,
        "hint": "超出上限时淘汰最久未使用的条目。", "minimum": 10, "maximum": 1000
      }
    }
  },
  "runtime": {
    "description": "浏览器与网络",
    "type": "object",
    "collapsed": true,
    "hint": "高级设置：正文抓取、代理与浏览器资源限制。",
    "items": {
      "fetch_mode": {
        "description": "正文抓取方式", "type": "string", "default": "httpx", "_special": "select",
        "hint": "HTTP 请求适合静态页面；需要 JavaScript 渲染的页面可使用系统浏览器。",
        "options": ["httpx", "browser"], "labels": ["HTTP 请求", "系统浏览器"]
      },
      "max_content_length": {
        "description": "正文长度上限（字符）", "type": "int", "default": 10000,
        "hint": "限制正文工具返回的文本长度。", "minimum": 1000, "maximum": 1000000
      },
      "request_timeout_s": {
        "description": "处理超时（秒）", "type": "int", "default": 30,
        "hint": "导航与请求超过此时间会中止。", "minimum": 5, "maximum": 300
      },
      "retry_count": {
        "description": "请求重试次数", "type": "int", "default": 3,
        "hint": "HTTP 抓取正文失败后的重试次数。", "minimum": 0, "maximum": 10
      },
      "retry_delay_s": {
        "description": "重试间隔（秒）", "type": "int", "default": 2,
        "hint": "再次请求前等待的时间。", "minimum": 0, "maximum": 10
      },
      "max_concurrency": {
        "description": "并发上限", "type": "int", "default": 5,
        "hint": "批量截图同时处理的链接数量上限。", "minimum": 1, "maximum": 20
      },
      "user_agent": {
        "description": "User-Agent", "type": "string", "default": "",
        "hint": "留空时使用浏览器或 HTTP 抓取的默认 User-Agent。"
      },
      "proxy": {
        "description": "HTTP 代理", "type": "string", "default": "", "secret": true,
        "hint": "留空不使用代理。格式：http://用户名:密码@主机:端口；配置文件仍以明文保存。"
      },
      "hide_ip": {
        "description": "截图使用代理并限制 WebRTC", "type": "bool", "default": false,
        "hint": "需要配置代理。不能保证匿名访问。"
      },
      "sandbox_mode": {
        "description": "沙箱模式", "type": "string", "default": "auto", "_special": "select",
        "hint": "自动模式按运行环境选择。禁用沙箱会降低浏览器隔离能力。",
        "options": ["auto", "always_disabled", "always_enabled"],
        "labels": ["自动检测", "始终禁用", "始终启用"]
      },
      "max_browser_instances": {
        "description": "最大实例数", "type": "int", "default": 3,
        "hint": "同时运行的浏览器进程上限，包含启动中和使用中的实例；内存紧张的容器可设为 1 或 2。", "minimum": 1, "maximum": 10
      },
      "enable_memory_monitor": {
        "description": "启用内存监控", "type": "bool", "default": false,
        "hint": "定期检查内存使用情况，超过阈值时释放资源。"
      },
      "memory_threshold_percent": {
        "description": "内存阈值（%）", "type": "float", "default": 80.0,
        "hint": "超过此占用比例时执行垃圾回收并缩减浏览器实例池。", "minimum": 0.0, "maximum": 100.0
      }
    }
  },
  "基础设置": {
    "description": "旧版本配置（已自动迁移，仅供升级识别）",
    "type": "dict",
    "invisible": true,
    "default": {}
  },
  "分析设置": {
    "description": "旧版本配置（已自动迁移，仅供升级识别）",
    "type": "dict",
    "invisible": true,
    "default": {}
  },
  "展示设置": {
    "description": "旧版本配置（已自动迁移，仅供升级识别）",
    "type": "dict",
    "invisible": true,
    "default": {}
  },
  "智能分析": {
    "description": "旧版本配置（已自动迁移，仅供升级识别）",
    "type": "dict",
    "invisible": true,
    "default": {}
  },
  "消息管理": {
    "description": "旧版本配置（已自动迁移，仅供升级识别）",
    "type": "dict",
    "invisible": true,
    "default": {}
  }
}
